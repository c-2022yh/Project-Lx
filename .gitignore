# This .gitignore file should be placed at the root of your Unity project directory
# Based on:
# https://github.com/github/gitignore/blob/main/Unity.gitignore


# =========================================================
# Unity generated folders
# =========================================================

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

*.log


# =========================================================
# Unity Memory Captures / Recordings
# =========================================================

# MemoryCaptures can get excessive in size
# They may also contain sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/


# =========================================================
# Asset Store Tools
# =========================================================

# Uncomment if your project uses Asset Store Tools
# /[Aa]ssets/AssetStoreTools*


# =========================================================
# JetBrains Rider
# =========================================================

# Unity generated Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Rider / IntelliJ local settings
.idea/

*.sln.iml
*.DotSettings.user


# =========================================================
# Visual Studio
# =========================================================

# Visual Studio cache
.vs/

# Auto-generated solution/project files
*.csproj
*.unityproj
*.sln
*.slnx

# Visual Studio user/local files
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

ExportedObj/
.consulo/


# =========================================================
# Visual Studio Code
# =========================================================

# VS Code settings are generally machine/user specific
.vscode/


# =========================================================
# Gradle / Android
# =========================================================

.gradle/


# =========================================================
# Debug symbols / generated databases
# =========================================================

*.pdb
*.mdb

*.pidb.meta
*.pdb.meta
*.mdb.meta


# =========================================================
# Unity crash reports
# =========================================================

sysinfo.txt


# =========================================================
# Build outputs
# =========================================================

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app


# =========================================================
# Crashlytics generated files
# =========================================================

crashlytics-build.properties


# =========================================================
# Addressables
# =========================================================

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*


# =========================================================
# Temporary auto-generated Android assets
# =========================================================

/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*