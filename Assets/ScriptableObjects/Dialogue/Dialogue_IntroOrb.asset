  lines:
  - speaker: "\uBCF4\uC8FC"
    portrait: {fileID: 21300000, guid: 176a7012dd304beea74bf3e6aac22384, type: 3}
    text: "\u2026\uB4E4\uB9AC\uB290\uB0D0. \uC624\uB798 \uAE30\uB2E4\uB838\uB2E4, \uC5EC\uC6B8\uC758 \uC544\uC774\uC57C."
  - speaker: "\uBCF4\uC8FC"
    portrait: {fileID: 21300000, guid: 176a7012dd304beea74bf3e6aac22384, type: 3}
    text: "\uBE5B\uC774 \uAC70\uC758 \uB2E4 \uAEBC\uC84C\uB2E4. \uB0A8\uC740 \uAC83\uC740 \uB098\uC640\u2026 \uB108\uBFD0\uC774\uAD6C\uB098."
  - speaker: "\uBCF4\uC8FC"
    portrait: {fileID: 21300000, guid: 176a7012dd304beea74bf3e6aac22384, type: 3}
    text: "\uB0B4 \uC190\uC744 \uC7A1\uC544\uB77C. \uD568\uAED8 \uC800 \uBC14\uAE65\uC73C\uB85C \uB098\uAC00\uC790."
