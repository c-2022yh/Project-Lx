--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8058562ecd1d4134bdee9babd8507055, type: 3}
  m_Name: Dialogue_IntroNarration
  m_EditorClassIdentifier: 
  style: 1
  tint: 0
  lines:
  - speaker: ""
    portrait: {fileID: 0}
    text: "\uC624\uB798\uC804, \uC774 \uC232\uC758 \uC5EC\uC6B8\uC5D0\uB294 \uBE5B\uC744 \uC9C0\uD0A4\uB294 \uC5EC\uC6B0\uB4E4\uC774 \uC0B4\uC558\uB2E4."
  - speaker: ""
    portrait: {fileID: 0}
    text: "\uC5EC\uC6B0\uB4E4\uC740 \uC800\uB9C8\uB2E4 \uBCF4\uC8FC\uB97C \uD488\uACE0, \uBB3C\uAE38\uACFC \uC232\uC758 \uC228\uC744 \uC774\uC5B4 \uC8FC\uC5C8\uB2E4."
  - speaker: ""
    portrait: {fileID: 0}
    text: "\uADF8\uB7EC\uB098 \uC5B4\uB290 \uBC24 \uC5EC\uC6B8\uC774 \uBA48\uCD94\uACE0, \uBCF4\uC8FC\uC758 \uBE5B\uC740 \uD558\uB098\uB458 \uAEBC\uC838 \uAC14\uB2E4."
  - speaker: ""
    portrait: {fileID: 0}
    text: "\u2026\uADF8\uB9AC\uACE0 \uC624\uB79C \uC7A0 \uB05D\uC5D0, \uB9C8\uC9C0\uB9C9 \uC5EC\uC6B0\uAC00 \uB208\uC744 \uB5B4\uB2E4."
